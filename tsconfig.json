{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "battleship/ts/**/*.ts",
    "flappybird/ts/**/*.ts",
    "foosball/ts/**/*.ts",
    "thanksgiving/ts/**/*.ts",
    "thankful_jesus/ts/**/*.ts",
    "pokemon_fight/ts/**/*.ts",
    "football_iq/ts/**/*.ts",
    "adventure_worlds/ts/**/*.ts"
  ]
}
